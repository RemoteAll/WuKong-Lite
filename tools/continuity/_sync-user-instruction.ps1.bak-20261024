# 把「资源与带宽惯例」改成**全项目适用**表述，并同步到全部已装备仓库 + 本机副本；版本 2026.10.24.2
$ErrorActionPreference = 'Stop'
$utf8 = New-Object Text.UTF8Encoding($false)

$files = @(
    (Join-Path $env:APPDATA 'Code\User\prompts\跨项目接续协议.instructions.md'),
    'G:\Code\Rust\Pek.RPanlServer\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RAgent\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RDbProxy\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RCard\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RPermissions\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RWaf\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\DH.RustBase\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RCode\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RAdmin\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.IP\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\HLZX.EIP\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Code\Rust\Pek.RPay\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Project\HlktechIoT\Tools\continuity\templates\用户级指令.instructions.md',
    'G:\Project\Pek.DDNS\tools\continuity\templates\用户级指令.instructions.md',
    'G:\Project\HlktechProductTool\tools\continuity\templates\用户级指令.instructions.md'
)

$newSection = @'
## 资源与带宽惯例（用户偏好 · 全项目适用）
- **适用范围：所有项目、所有进程**——服务端 / Agent / 采集器 / 定时任务 / 工具 / 客户端 / 面板与前端，不只是集群里的某两个进程；**新增或修改任何周期行为（Timer、轮询、watch、心跳、缓存刷新、巡检）都按本节自检**。
- **核心口径**：任何程序都要尽量少占 CPU、内存、磁盘 IO 与网络带宽，**非必要不做周期性全量劳作**。（2026-10-24 用户原话：「要尽量减少 RAgent 本身的压力和性能及资源还有网络带宽，RPanelServer 同样也要考虑这些。非必要不要经常性的去占用消耗」；随后明确：这条适用于**所有涉及到的项目**，不止这两个。）
- **周期任务必须变化驱动 + 缓存**：心跳 / 采集 / 巡检按「签名」比对（配置文件的 mtime + 长度、白名单 / 名单字符串、上次快照值），无变化时只做元数据或内存比对，**不读盘、不解析、不重算**。
- **周期报文只带变化项**：未变化字段发 `null`（对端保留旧值），不要每跳重复上传几 KB 清单；实测站点摘要从每 60 秒 ~8 KB 降到 ~0.6 KB。
- **源头过滤无意义数据**：无域名 / 仅回环的占位站点、临时挂载盘、系统伪目录等，一律在产生处剔除，不让它进入上报、统计与界面。
- **新增周期任务前先算账**：给出「单次耗时 + 每分钟 / 每小时累计开销」并写入决策记录；超过单核 1% 或 1 MB/分钟带宽的方案必须先论证。
- **面板轮询一律带 `document.hidden` 守卫**，后台标签页不空转；常驻轮询只允许必要项（如资源卡 3 秒）。
- **日志 / 审计只记有意义事件**：不要为每次轮询 / 每跳心跳写一行审计；高频路径用聚合计数或降采样。
- **ORM 脏更新的适用边界（Pek.RCode）**：`DirtyState` 只记录「被 setter 改过的列」，**不读库**；缓存来自 `find` 命中 `SingleCache` / `EntityCache`，是另一套机制。适合业务实体局部修改（改 1 列就写 1 列）；**高频外部数据写入（心跳 / 上报）或含大文本列且写频繁的表不要用实体脏更新**——用表级 API + 进程内快照 diff（否则会多一次读，且整表缓存会把大字段全缓存）。
'@

foreach ($f in $files) {
    if (-not (Test-Path $f)) { "MISSING $f"; continue }
    $bytes = [IO.File]::ReadAllBytes($f)
    $hasBom = ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF)
    $t = [IO.File]::ReadAllText($f, [Text.Encoding]::UTF8)
    $nl = [string][char]10
    $sec = $newSection.Replace("`r`n", $nl)
    $marker = '<!-- 版本：'
    if ($t.Contains('## 资源与带宽惯例')) {
        $start = $t.IndexOf('## 资源与带宽惯例')
        $end = $t.IndexOf($marker, $start)
        if ($end -lt 0) { "NO-MARKER $f"; continue }
        $t = $t.Substring(0, $start) + $sec + $nl + $t.Substring($end)
    }
    else {
        $i = $t.LastIndexOf($marker)
        if ($i -lt 0) { "NO-MARKER $f"; continue }
        $t = $t.Substring(0, $i) + $sec + $nl + $t.Substring($i)
    }
    $t = [regex]::Replace($t, '版本：\d{4}\.\d{2}\.\d{2}\.\d+', '版本：2026.10.24.2')
    $enc = if ($hasBom) { New-Object Text.UTF8Encoding($true) } else { $utf8 }
    [IO.File]::WriteAllText($f, $t, $enc)
    "OK $f"
}

$exist = $files | Where-Object { Test-Path $_ }
$hashes = $exist | ForEach-Object { (Get-FileHash $_ -Algorithm SHA256).Hash }
"哈希去重数：$(( $hashes | Sort-Object -Unique ).Count) / 文件数：$($hashes.Count)"
